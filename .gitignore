# Secrets: keys and contact details live in .env, never in git
.env
.env.*
!.env.example

# Python environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Downloaded data (re-created on demand)
data/cache/

# Foundry build output
contracts/out/
contracts/cache/

# Charts generated by running tools
*.html

# Foundry libraries (reinstall with: forge install foundry-rs/forge-std --no-git)
contracts/lib/
